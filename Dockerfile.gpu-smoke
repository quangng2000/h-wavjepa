# Official PyTorch runtime, verified linux/amd64 digest (CUDA 12.6, torch 2.13.0).
FROM pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime@sha256:6acf597eeb8e376a96580dde4952f37cc017fef732bb40bfc73f28f25e3f64b4
WORKDIR /app
COPY pyproject.toml uv.lock requirements.txt .project-root ./
# Lock Python dependencies to this repository's lockfile while retaining the
# image's matched CUDA/Torch stack. Installation occurs during the CPU build.
RUN python -c "import tomllib; p=tomllib.load(open('uv.lock','rb'))['package']; skip={'torch','torchvision','torchaudio','triton'}; open('/tmp/smoke-constraints.txt','w').write('\n'.join(x['name']+'=='+x['version']+(' ; '+' or '.join(x['resolution-markers']) if x.get('resolution-markers') else '') for x in p if 'version' in x and x['name'] not in skip and not x['name'].startswith('nvidia-')))" \
    && python -m pip install --break-system-packages --no-cache-dir -c /tmp/smoke-constraints.txt -r requirements.txt pytest \
    && python -m pip freeze > /app/smoke-environment.txt
COPY src/ src/
COPY configs/ configs/
COPY tests/ tests/
COPY scripts/ scripts/
COPY third_party/ third_party/
COPY THIRD_PARTY_NOTICES.md ./
ENV PYTHONPATH=/app OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
CMD ["python", "scripts/smoke_gpu.py", "--output", "/output/h-wavjepa-smoke"]
